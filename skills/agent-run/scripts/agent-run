#!/usr/bin/env bash
# agent-run: run Claude Code or Codex non-interactively, with run state kept on disk.
#
#   agent-run start  <run-dir> <claude|codex> <builder|reviewer> [--model M] [--effort E] [--cwd DIR] [--prompt FILE]
#   agent-run resume <run-dir> <prompt-file>
#   agent-run status [<dir>]
#
# start   sends <run-dir>/prompt.md (or --prompt FILE) to a new session and records it in <run-dir>/meta.
# resume  sends a follow-up to the same session with the same agent, model, effort and permissions.
# status  prints one line per run dir found under <dir> (default: current dir).
#
# Each call is one turn N: turn-N.md (final message), turn-N.log (stderr/stdout), turn-N.exit.
# Builders run without permission prompts; reviewers run read-only.
# Machine overrides: AGENT_RUN_CLAUDE / AGENT_RUN_CODEX, or executables ~/.config/agent-run/{claude,codex}
# (use them to wrap a CLI in a gateway). Default models: AGENT_RUN_CLAUDE_MODEL, AGENT_RUN_CODEX_MODEL.
# Exit code: the agent's exit code, or 3 when a reviewer's last line is not a verdict.
set -u

die() { echo "agent-run: $*" >&2; exit 2; }

launcher() {
  local name=$1 var=$2
  if [ -n "${!var:-}" ]; then echo "${!var}"
  elif [ -x "$HOME/.config/agent-run/$name" ]; then echo "$HOME/.config/agent-run/$name"
  else echo "$name"; fi
}

verdict_of() { # last non-empty line of a report
  [ -s "$1" ] && awk 'NF { line = $0 } END { gsub(/^[ \t*`]+|[ \t*`]+$/, "", line); print line }' "$1"
}

is_verdict() {
  case "$1" in
    APPROVED|"CHANGES REQUIRED"|"VERDICT: APPROVED"|"VERDICT: CHANGES REQUIRED"|"DELIVERY COMPLETE"|"DELIVERY INCOMPLETE") return 0 ;;
    *) return 1 ;;
  esac
}

run_turn() { # uses AGENT ROLE MODEL EFFORT CWD SID from meta; $1 = prompt file
  local prompt=$1 n out log code
  n=$(( $(command ls "$D"/turn-*.started 2>/dev/null | wc -l) + 1 ))
  out=$D/turn-$n.md; log=$D/turn-$n.log
  echo $$ > "$D/pid"; date +%s > "$D/turn-$n.started"
  cp "$prompt" "$D/turn-$n.prompt.md" 2>/dev/null || true

  if [ "$AGENT" = claude ]; then
    local bin perms json
    bin=$(launcher claude AGENT_RUN_CLAUDE); json=$D/turn-$n.json
    if [ "$ROLE" = builder ]; then perms=(--dangerously-skip-permissions)
    else perms=(--permission-mode dontAsk --allowedTools "Read Grep Glob Bash(git diff *) Bash(git log *) Bash(git show *) Bash(git status *) Bash(git blame *)"); fi
    local resume=(); [ -n "$SID" ] && resume=(--resume "$SID")
    (cd "$CWD" && "$bin" -p ${resume[@]+"${resume[@]}"} --model "$MODEL" --effort "$EFFORT" "${perms[@]}" \
      --output-format json < "$prompt" > "$json" 2> "$log")
    code=$?
    jq -r '.result // empty' "$json" > "$out" 2>/dev/null
    [ -z "$SID" ] && SID=$(jq -r '.session_id // empty' "$json" 2>/dev/null)
    jq -r '"cost_usd=\(.total_cost_usd // 0) duration_ms=\(.duration_ms // 0)"' "$json" >> "$D/usage" 2>/dev/null
  else
    local bin cfg sandbox
    bin=$(launcher codex AGENT_RUN_CODEX)
    cfg=(-m "$MODEL" -c "model_reasoning_effort='$EFFORT'")
    if [ "$ROLE" = builder ]; then sandbox=(--dangerously-bypass-approvals-and-sandbox)
    else sandbox=(-c 'sandbox_mode="read-only"'); fi
    # `exec resume` rejects -C and -s, and falls back to the config default model unless -m is repeated.
    if [ -z "$SID" ]; then
      (cd "$CWD" && "$bin" exec --skip-git-repo-check "${cfg[@]}" "${sandbox[@]}" -o "$out" - < "$prompt" > "$log" 2>&1)
      code=$?
      SID=$(grep -m1 -oE 'session id: [0-9a-f-]+' "$log" | awk '{print $3}')
    else
      (cd "$CWD" && "$bin" exec resume "$SID" --skip-git-repo-check "${cfg[@]}" "${sandbox[@]}" -o "$out" - < "$prompt" > "$log" 2>&1)
      code=$?
    fi
  fi

  write_meta
  [ -s "$out" ] || { echo "agent-run: empty report $out (see $log)" >&2; [ "$code" = 0 ] && code=1; }
  if [ "$code" = 0 ] && [ "$ROLE" = reviewer ] && ! is_verdict "$(verdict_of "$out")"; then
    echo "agent-run: reviewer report has no verdict line: $out" >&2; code=3
  fi
  echo "$code" > "$D/turn-$n.exit"
  rm -f "$D/pid"
  echo "$out"
  return "$code"
}

write_meta() {
  { printf 'AGENT=%q\nROLE=%q\nMODEL=%q\nEFFORT=%q\nCWD=%q\nSID=%q\n' \
      "$AGENT" "$ROLE" "$MODEL" "$EFFORT" "$CWD" "$SID"; } > "$D/meta"
}

status() {
  local root=${1:-.} m d now
  now=$(date +%s)
  find "$root" -maxdepth 4 -name meta -type f 2>/dev/null | sort | while read -r m; do
    d=$(dirname "$m")
    ( . "$m"
      local n state last started secs verdict cost
      n=$(command ls "$d"/turn-*.started 2>/dev/null | wc -l | tr -d ' ')
      last=$d/turn-$n
      started=$(cat "$last.started" 2>/dev/null || echo "$now")
      if [ -f "$last.exit" ]; then state="exit=$(cat "$last.exit")"
        secs=$(( $(stat -f %m "$last.exit" 2>/dev/null || stat -c %Y "$last.exit") - started ))
      elif [ -f "$d/pid" ] && kill -0 "$(cat "$d/pid")" 2>/dev/null; then state=running; secs=$(( now - started ))
      else state=dead; secs=$(( now - started )); fi
      verdict=""; [ "$ROLE" = reviewer ] && verdict=$(verdict_of "$last.md")
      cost=$(awk -F'[= ]' '{s += $2} END { if (s) printf "$%.2f", s }' "$d/usage" 2>/dev/null)
      printf '%-28s %-8s %-6s %-22s turn %-2s %-8s %4dm  %s %s\n' \
        "${d#"$root"/}" "$ROLE" "$AGENT" "$MODEL/$EFFORT" "$n" "$state" $(( secs / 60 )) "$cost" "$verdict" )
  done
}

cmd=${1:-}; shift || true
case "$cmd" in
  start)
    [ $# -ge 3 ] || die "usage: agent-run start <run-dir> <claude|codex> <builder|reviewer> [--model M] [--effort E] [--cwd DIR] [--prompt FILE]"
    mkdir -p "$1"; D=$(cd "$1" && pwd); AGENT=$2; ROLE=$3; shift 3
    case "$AGENT" in claude|codex) ;; *) die "agent must be claude or codex" ;; esac
    case "$ROLE" in builder|reviewer) ;; *) die "role must be builder or reviewer" ;; esac
    [ -f "$D/meta" ] && die "$D already has a session; use resume, or a new run dir"
    MODEL=""; EFFORT=""; CWD=$PWD; PROMPT=$D/prompt.md; SID=""
    while [ $# -gt 0 ]; do
      [ $# -ge 2 ] || die "$1 needs a value"
      case "$1" in
        --model) MODEL=$2 ;; --effort) EFFORT=$2 ;; --cwd) CWD=$(cd "$2" && pwd) ;; --prompt) PROMPT=$2 ;;
        *) die "unknown option $1" ;;
      esac; shift 2
    done
    if [ "$AGENT" = claude ]; then MODEL=${MODEL:-${AGENT_RUN_CLAUDE_MODEL:-opus}}
    else MODEL=${MODEL:-${AGENT_RUN_CODEX_MODEL:-gpt-6.1-sol}}; fi
    [ "$ROLE" = builder ] && EFFORT=${EFFORT:-medium} || EFFORT=${EFFORT:-high}
    [ -s "$PROMPT" ] || die "prompt not found: $PROMPT"
    write_meta
    run_turn "$PROMPT" ;;
  resume)
    [ $# -eq 2 ] || die "usage: agent-run resume <run-dir> <prompt-file>"
    D=$(cd "$1" && pwd); [ -f "$D/meta" ] || die "no session in $D"
    PROMPT=$(cd "$(dirname "$2")" && pwd)/$(basename "$2")
    . "$D/meta"
    [ -n "$SID" ] || die "no session id recorded in $D/meta; the first turn failed (see its log)"
    run_turn "$PROMPT" ;;
  status) status "$@" ;;
  *) sed -n '2,18p' "$0"; exit 2 ;;
esac
